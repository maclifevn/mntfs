<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EXAppExtensionAttributes</key>
	<dict>
		<key>EXExtensionPointIdentifier</key>
		<string>com.apple.fskit.fsmodule</string>
		<key>FSActivateOptionSyntax</key>
		<dict>
			<key>shortOptions</key>
			<string>g:m:o:u:</string>
		</dict>
		<key>FSCheckOptionSyntax</key>
		<dict>
			<key>shortOptions</key>
			<string>fnqy</string>
		</dict>
		<key>FSMediaTypes</key>
		<dict>
			<!-- MBR partition type: classic NTFS USB drives.
			     Beat Apple's read-only ntfs handler (order 1000). -->
			<key>Windows_NTFS</key>
			<dict>
				<key>FSMediaProperties</key>
				<dict>
					<key>Content Hint</key>
					<string>Windows_NTFS</string>
					<key>Leaf</key>
					<true/>
				</dict>
				<key>FSProbeOrder</key>
				<integer>500</integer>
			</dict>
			<!-- GPT: Microsoft Basic Data. Probe rejects non-NTFS quickly. -->
			<key>EBD0A0A2-B9E5-4433-87C0-68B6B72699C7</key>
			<dict>
				<key>FSMediaProperties</key>
				<dict>
					<key>Content Hint</key>
					<string>EBD0A0A2-B9E5-4433-87C0-68B6B72699C7</string>
					<key>Leaf</key>
					<true/>
				</dict>
				<key>FSProbeOrder</key>
				<integer>1500</integer>
			</dict>
			<!-- Partitionless media (raw disk images, superfloppy drives). -->
			<key>Partitionless</key>
			<dict>
				<key>FSMediaProperties</key>
				<dict>
					<key>Leaf</key>
					<true/>
					<key>Whole</key>
					<true/>
				</dict>
				<key>FSProbeOrder</key>
				<integer>3000</integer>
			</dict>
		</dict>
		<key>FSPersonalities</key>
		<dict>
			<key>Mntfs</key>
			<dict>
				<key>FSName</key>
				<string>Mntfs</string>
				<key>FSfileObjectsAreCaseSensitive</key>
				<false/>
			</dict>
		</dict>
		<key>FSRequiresSecurityScopedPathURLResources</key>
		<false/>
		<key>FSShortName</key>
		<string>mntfs</string>
		<key>FSSupportsBlockResources</key>
		<true/>
		<key>FSSupportsGenericURLResources</key>
		<false/>
		<key>FSSupportsPathURLs</key>
		<false/>
		<key>FSSupportsServerURLs</key>
		<false/>
	</dict>
</dict>
</plist>
