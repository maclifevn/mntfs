<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The host app is intentionally NOT sandboxed: it enumerates and mounts
	  volumes via diskutil, which the App Sandbox blocks. Distributed with
	  Developer ID + notarization (not the App Store). The FSKit extension keeps
	  its own sandbox + fskit entitlement.
	-->
</dict>
</plist>
